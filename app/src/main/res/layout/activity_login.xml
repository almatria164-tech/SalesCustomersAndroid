<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="42dp"
        android:paddingBottom="35dp">

        <!-- Logo -->

        <TextView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="#2563EB"
            android:gravity="center"
            android:text="📒"
            android:textSize="36sp"
            android:elevation="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="مرحبًا بك"
            android:textColor="#0F172A"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Smart Nota"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تسجيل الدخول"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="أدخل بيانات حسابك للمتابعة"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- Email -->

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="#F8FAFC"
                android:hint="البريد الإلكتروني"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:gravity="right|center_vertical"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <!-- Password -->

            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="11dp"
                android:background="#F8FAFC"
                android:hint="كلمة المرور"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:gravity="right|center_vertical"
                android:inputType="textPassword"
                android:singleLine="true" />

            <!-- Login -->

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#2563EB"
                android:text="تسجيل الدخول"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <!-- Register -->

            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EFF6FF"
                android:text="إنشاء حساب جديد"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <!-- Divider -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="أو"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

            </LinearLayout>

            <!-- Google -->

            <Button
                android:id="@+id/googleButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFFFFF"
                android:text="  تسجيل الدخول باستخدام Google"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="بياناتك محفوظة بأمان"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
